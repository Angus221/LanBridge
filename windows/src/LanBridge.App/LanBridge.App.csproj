<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LanBridge.App</RootNamespace>
    <AssemblyName>LanBridge</AssemblyName>
    <ApplicationIcon>Assets\lanbridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\LanBridge.Core\LanBridge.Core.csproj" />
    <ProjectReference Include="..\LanBridge.Server\LanBridge.Server.csproj" />
    <ProjectReference Include="..\LanBridge.Storage\LanBridge.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\lanbridge.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
</Project>
