<Window x:Class="LanBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanBridge.App"
        Title="兰桥" Width="18" Height="640" MinWidth="18" MinHeight="320"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="BoolVis"/>
        <local:ThemeBrushConverter x:Key="ThemeBrush"/>
    </Window.Resources>
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="18,18,10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVis}, ConverterParameter=hide}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding PinLabel}" Command="{Binding TogglePinCommand}"
                                    MinWidth="76" Margin="12,0,0,0" AutomationProperties.Name="固定侧栏"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="兰桥" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="14"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Phones}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="176" Margin="0,0,12,4" Padding="14,16,14,12" CornerRadius="28"
                                                Background="{DynamicResource CardBrush}" BorderThickness="1.5"
                                                BorderBrush="{Binding Selected, Converter={StaticResource ThemeBrush}}">
                                            <StackPanel>
                                                <Border Height="5" Width="46" CornerRadius="3" Background="{DynamicResource LineBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                                <Border Background="Transparent" Cursor="Hand" Focusable="True" MinHeight="48">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectPhoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding DeviceId}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                                                        <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <CheckBox Content="剪贴板" IsChecked="{Binding ClipboardSync, Mode=TwoWay}" Margin="0,12,0,4"
                                                          AutomationProperties.Name="这台手机的剪贴板自动同步"/>
                                                <Button Content="设置" MinHeight="36" Padding="8,4"
                                                        Command="{Binding DataContext.OpenPhoneSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding DeviceId}"
                                                        AutomationProperties.Name="这台手机的设置"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding PhoneSettingsOpen, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PhoneSettingsName}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Text="解除信任后，这台手机需要重新配对。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <Button Content="解除信任" HorizontalAlignment="Left"
                                        Command="{Binding RevokeCommand}" CommandParameter="{Binding PhoneSettingsId}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="传输记录" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Transfers}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14" CornerRadius="16" Background="{DynamicResource CardBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Origin}" FontWeight="SemiBold"
                                                           Foreground="{Binding Origin, Converter={StaticResource ThemeBrush}, ConverterParameter=origin}"/>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}"/>
                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12">
                                                    <Run Text="{Binding When, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Meta, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="复制" MinWidth="72" Margin="0,0,0,6"
                                                        Visibility="{Binding CanCopy, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding CopyText}"/>
                                                <Button Content="打开" MinWidth="72" Margin="0,0,0,6"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding LocalPath}"/>
                                                <Button Content="显示" MinWidth="72"
                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding LocalPath}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="14" Margin="0,0,0,12"
                                Visibility="{Binding PairingOpen, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Border Width="160" Height="160" Background="White" CornerRadius="12" HorizontalAlignment="Left">
                                    <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="8"/>
                                </Border>
                                <TextBlock Text="配对码" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Pin}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8">
                                    <Run Text="{Binding PairingSeconds, Mode=OneWay}"/><Run Text=" 秒后失效"/>
                                </TextBlock>
                                <TextBlock Text="{Binding PairingHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                <Button Content="取消配对" Command="{Binding CancelPairingCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Button Content="添加手机" MinHeight="72" Margin="0,0,0,12" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartPairingCommand}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="关闭后兰桥留在托盘和屏幕右缘。文件只保存，不会自动打开。"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="建议发送剪贴板用 Ctrl+Alt+V，打开侧栏用 Ctrl+Alt+L。两个快捷键不能相同；如果已被其他程序占用，下面会提示。"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="发送剪贴板" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding HotkeySend, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>
                        <TextBlock Text="打开或收起侧栏" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding HotkeySidebar, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="这台电脑的名称" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="接收文件保存到" Foreground="{DynamicResource MutedBrush}"/>
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding IncomingDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                        </DockPanel>
                        <CheckBox Content="自动接收已配对手机发来的文件" IsChecked="{Binding AutoReceive}"/>
                        <CheckBox Content="剪贴板总开关（每台手机的卡片上还可以单独关）" IsChecked="{Binding ClipboardSync}"/>
                        <CheckBox Content="暂停剪贴板同步" IsChecked="{Binding ClipboardPaused}"/>
                        <CheckBox Content="把文字传输记入历史（疑似密码不会写入）" IsChecked="{Binding SaveTextHistory}"/>
                        <CheckBox Content="拦截疑似密码、私钥和访问令牌" IsChecked="{Binding FilterSensitive}"/>
                        <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding RunAtStartup}" Margin="0,0,0,12"/>
                        <Button Content="清空传输记录" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Left"/>
                        <Button Content="完成" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,56,0"/>
                    <Button Width="44" Height="44" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="设置" AutomationProperties.Name="设置"
                            Background="{DynamicResource CardBrush}">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource InkBrush}"
                              Data="M19.14,12.94c0.04,-0.31 0.06,-0.63 0.06,-0.94c0,-0.31 -0.02,-0.63 -0.06,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.22,5.35C8.63,5.59 8.1,5.92 7.6,6.29L5.21,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.7,8.87C2.59,9.08 2.64,9.34 2.82,9.48l2.03,1.58C4.8,11.37 4.78,11.69 4.78,12s0.02,0.63 0.06,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94z M12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6 3.6,1.62 3.6,3.6 -1.62,3.6 -3.6,3.6z"/>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="Transparent" Cursor="Hand" ToolTip="兰桥">
                <Border Width="6" Height="84" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
