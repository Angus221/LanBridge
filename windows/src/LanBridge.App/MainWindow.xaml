<Window x:Class="LanBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanBridge.App"
        Title="兰桥" Height="720" Width="960" MinHeight="560" MinWidth="760"
        Background="{StaticResource PaperBrush}"
        Icon="Assets/lanbridge.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="兰桥" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#F2C572" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding FingerprintText}" Foreground="#D5E2E8" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="360"/>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20" MaxWidth="920">
                <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="发送文件" Style="{StaticResource PrimaryButton}" Command="{Binding SendFileCommand}" Margin="0,0,10,0"/>
                    <Button Content="发送剪贴板" Command="{Binding SendClipboardCommand}" Margin="0,0,10,0"/>
                    <Button Content="配对手机" Command="{Binding StartPairingCommand}"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18" Margin="0,0,0,16"
                        Visibility="{Binding PairingOpen, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="180" Height="180" Background="White" Margin="0,0,18,0">
                            <Image Source="{Binding QrImage}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="配对码" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Pin}" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,8"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding PairingSeconds, Mode=OneWay}"/><Run Text=" 秒后失效"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PairingHint}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <Button Content="取消配对" Command="{Binding CancelPairingCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="最近传输" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding EmptyHint}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                    <ListBox ItemsSource="{Binding Transfers}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开所在文件夹" Padding="10,4" FontSize="12"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding LocalPath}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Expander Header="设置" Margin="0,18,0,0" FontSize="16" Foreground="{StaticResource InkBrush}">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="这台电脑的名称" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8,6"/>
                        <TextBlock Text="接收文件保存到" Foreground="{StaticResource MutedBrush}"/>
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding IncomingDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" IsReadOnly="True"/>
                        </DockPanel>
                        <CheckBox Content="自动接收已配对手机发来的文件" IsChecked="{Binding AutoReceive}" Margin="0,0,0,8"/>
                        <CheckBox Content="剪贴板自动同步（默认关闭，打开后这台电脑复制的文字会发到手机）" IsChecked="{Binding ClipboardSync}" Margin="0,0,0,8"/>
                        <CheckBox Content="暂停剪贴板同步" IsChecked="{Binding ClipboardPaused}" Margin="0,0,0,8"/>
                        <CheckBox Content="把文字传输记入历史（疑似密码不会写入）" IsChecked="{Binding SaveTextHistory}" Margin="0,0,0,8"/>
                        <CheckBox Content="拦截疑似密码、私钥和访问令牌" IsChecked="{Binding FilterSensitive}" Margin="0,0,0,8"/>
                        <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding RunAtStartup}" Margin="0,0,0,12"/>
                        <TextBlock Text="已配对的手机" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="解除信任" Padding="10,4"
                                                Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding DeviceId}"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="清空传输记录" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
                <TextBlock Text="关闭窗口后兰桥仍在托盘里。收到的文件只保存，不会自动打开或运行。"
                           Foreground="{StaticResource MutedBrush}" Margin="0,18,0,8" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
